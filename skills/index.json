  "router_output_schema": {
    "primary_intent": "string — 必须来自 intent_to_module 的 key，禁止自创。例如 STOCK_PRICE_INQUIRY, STRATEGIC_BULK_INQUIRY, NON_BUSINESS_EMAIL, BANK_ACCOUNT_CHANGE_REQUEST",
    "secondary_intents": [
      "string — 必须来自 intent_to_module 的 key，且数量不超过 router_config.max_secondary_intents"
    ],
    "action": "REPLY | NO_REPLY",
    "intercept_reason": "string — 仅当 action=NO_REPLY 时填写，一行简短中文，说明拦截原因",
    "risk_level": "LOW | MEDIUM | HIGH",
    "confidence": "number — 0.0~1.0，表示 primary_intent 判定的置信度",
    "entities": {
      "container_type": "string — 系统箱型缩写，多箱型用英文逗号分隔；缺失填空字符串",
      "requested_color": "string — 客户指定颜色，缺失填空字符串",
      "requested_condition": "string — 客户指定箱况，缺失填空字符串",
      "container_number": "string — 11 位标准箱号，缺失填空字符串",
      "invoice_number": "string — 缺失填空字符串",
      "pi_number": "string — PI 号（HM 开头），缺失填空字符串",
      "release_code": "string — 放箱码，缺失填空字符串",
      "company_role": "customer | vendor | intermediary",
      "target_location": "string — 提箱城市/国家/大洲；缺失填空字符串",
      "sender_name": "string — 发件人姓名，缺失填空字符串",
      "requested_quantity": 0,
      "line_items": [
        {
          "container_type": "string — 与顶层 container_type 同义，单条询盘的箱型",
          "condition": "string — 与顶层 requested_condition 同义（简写）",
          "color": "string — 与顶层 requested_color 同义（简写）",
          "location": "string — 与顶层 target_location 同义（简写）",
          "quantity": 0,
          "expected_unit_price_usd": 0
        }
      ],
      "expected_unit_price_usd": "number — 客户明确提出的USD单箱预期采购单价，如每台USD1500写1500；未提及或只有其他货币/整单总预算/价格区间则填0；严禁猜测"
    },
    "schema_note": "line_items 内使用简写字段名（condition/color/location），顶层使用长名（requested_condition/requested_color/target_location）。这是历史兼容设计，AI 输出时必须严格遵守，不可混用。 expected_unit_price_usd 在顶层及 line_items 内均为USD单箱目标价；多箱型必须分行分别填写，无法确认归属则为0。"
  }
}
